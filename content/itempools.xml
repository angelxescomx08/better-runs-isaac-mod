<ItemPools>
    <!--
        Adds items to the shop pool that are not normally purchasable.
        The game merges this file with the base itempools.xml automatically.

        Weight    : relative probability of the item being picked from the pool.
        DecreaseBy: how much weight is lost each time the item is selected.
        RemoveOn  : weight floor below which the item leaves the pool for the run.
    -->
